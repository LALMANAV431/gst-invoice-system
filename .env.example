# ---------------------------------------------------------------------------
# GST Invoice System - environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit `.env`. It is already listed in .gitignore.
# NEVER put a real secret, GSTIN, PAN, Aadhaar, bank detail or production
# credential in THIS file - it is tracked by git.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Local development (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
#
# Production (PostgreSQL - strongly recommended, see docs/ARCHITECTURE.md):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gstinvoice?schema=public&sslmode=require"
#
# When using docker-compose, the app container reaches Postgres by service name:
# DATABASE_URL="postgresql://gst:gst_local_dev_password@db:5432/gstinvoice?schema=public"

# --- Session / auth ---------------------------------------------------------
# REQUIRED. The app refuses to boot in production without this.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# How long a session cookie stays valid.
SESSION_MAX_AGE_DAYS="30"

# --- Application ------------------------------------------------------------
# Public base URL. Used for payment callbacks, emailed links and PDF QR codes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Default language for new users: "en" or "hi".
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. The application runs fully without it -
# the related feature simply stays switched off.
# ---------------------------------------------------------------------------

# --- AI features (optional) -------------------------------------------------
# Leave AI_PROVIDER as "mock" to develop and demo with no API key and no spend.
# "mock" returns deterministic canned responses so tests stay reproducible.
# Options: mock | openai | gemini | anthropic | local
AI_PROVIDER="mock"
AI_ENABLED="false"

# Only the key for your chosen provider is needed.
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""
# ANTHROPIC_API_KEY=""
# LOCAL_AI_BASE_URL="http://localhost:11434/v1"

# Model + spend guardrails. See docs/ARCHITECTURE.md for the cost-control design.
AI_MODEL="gpt-4o-mini"
AI_MONTHLY_TOKEN_BUDGET="2000000"
AI_MAX_TOKENS_PER_REQUEST="4000"
# Never send party names / GSTINs to a third-party model when this is true.
AI_REDACT_PII="true"

# --- Payment gateway (optional) --------------------------------------------
# Use TEST keys in development. Razorpay test keys start with rzp_test_.
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Stripe (optional, for international billing)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# --- Email (optional) -------------------------------------------------------
# Without these, invoice email is disabled and the UI hides the Email button.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="GST Invoice <billing@example.com>"

# --- WhatsApp / SMS (optional) ---------------------------------------------
# WhatsApp Cloud API. Without these, the app falls back to a wa.me share link,
# which needs no credentials and no per-message cost.
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_TEMPLATE_INVOICE="invoice_share"

# SMS_PROVIDER=""
# SMS_API_KEY=""
# SMS_SENDER_ID=""

# --- E-Invoice / E-Way Bill (optional) -------------------------------------
# Government IRP credentials, obtained via a registered GSP.
# Use the sandbox endpoint until you have production clearance.
# EINVOICE_ENABLED="false"
# EINVOICE_BASE_URL="https://einv-apisandbox.nic.in"
# EINVOICE_CLIENT_ID=""
# EINVOICE_CLIENT_SECRET=""
# EINVOICE_USERNAME=""
# EINVOICE_PASSWORD=""

# --- File storage (optional) -----------------------------------------------
# Defaults to the local filesystem. Use S3-compatible storage in production
# so attachments survive container restarts.
STORAGE_DRIVER="local"
# S3_ENDPOINT=""
# S3_REGION="ap-south-1"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Error tracking / monitoring (optional) --------------------------------
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# --- Rate limiting (optional) ----------------------------------------------
# Falls back to an in-process limiter when unset. That is fine for a single
# instance but does NOT work across multiple containers - use Redis for that.
# REDIS_URL="redis://localhost:6379"
RATE_LIMIT_LOGIN_PER_MINUTE="5"
RATE_LIMIT_API_PER_MINUTE="120"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN") // ADMIN | ACCOUNTANT | OPERATOR | VIEWER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies   Company[]
  memberships TeamMember[]
  auditLogs   AuditLog[]
}

model TeamMember {
  id        String   @id @default(cuid())
  role      String   @default("ACCOUNTANT") // ADMIN | ACCOUNTANT | OPERATOR | VIEWER
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Company {
  id            String   @id @default(cuid())
  name          String
  gstin         String?
  pan           String?
  email         String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  pincode       String?
  stateCode     String?
  logoUrl       String?
  invoicePrefix String   @default("INV")
  purchasePrefix String  @default("PUR")
  paymentPrefix String   @default("PMT")
  quotationPrefix String @default("QUO")
  creditNotePrefix String @default("CN")
  debitNotePrefix String  @default("DN")
  expensePrefix String   @default("EXP")
  financialYear String   @default("2025-26")
  terms         String?
  bankName      String?
  bankAccountNo String?
  bankIfsc      String?
  upiId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  parties        Party[]
  items          Item[]
  invoices       Invoice[]
  purchases      Purchase[]
  payments       Payment[]
  stockMovements StockMovement[]
  quotations     Quotation[]
  creditNotes    CreditNote[]
  expenses       Expense[]
  teamMembers    TeamMember[]
  godowns        Godown[]
  stockTransfers StockTransfer[]
  recurringInvoices RecurringInvoice[]
  bankTransactions  BankTransaction[]
  budgets        Budget[]
  auditLogs      AuditLog[]
}

model Party {
  id           String   @id @default(cuid())
  name         String
  type         String   // CUSTOMER | VENDOR | BOTH
  gstin        String?
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?
  stateCode    String?
  openingBalance Float  @default(0)
  balanceType  String   @default("RECEIVABLE") // RECEIVABLE | PAYABLE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoices  Invoice[]
  purchases Purchase[]
  payments  Payment[]
  quotations  Quotation[]
  creditNotes CreditNote[]
  expenses    Expense[]

  @@index([companyId])
}

model Item {
  id           String   @id @default(cuid())
  name         String
  sku          String?
  hsn          String?
  barcode      String?
  unit         String   @default("NOS")
  salePrice    Float    @default(0)
  purchasePrice Float   @default(0)
  gstRate      Float    @default(18)
  openingStock Float    @default(0)
  currentStock Float    @default(0)
  lowStockAlert Float   @default(0)
  description  String?
  godownId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  godown    Godown? @relation(fields: [godownId], references: [id])

  invoiceItems   InvoiceItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  quotationItems  QuotationItem[]
  creditNoteItems CreditNoteItem[]

  @@index([companyId])
}

model Invoice {
  id            String   @id @default(cuid())
  number        String
  date          DateTime @default(now())
  dueDate       DateTime?
  notes         String?
  status        String   @default("UNPAID") // PAID | PARTIAL | UNPAID
  subTotal      Float    @default(0)
  cgstTotal     Float    @default(0)
  sgstTotal     Float    @default(0)
  igstTotal     Float    @default(0)
  taxTotal      Float    @default(0)
  discount      Float    @default(0)
  roundOff      Float    @default(0)
  grandTotal    Float    @default(0)
  amountPaid    Float    @default(0)
  isInterState  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id])

  items    InvoiceItem[]
  payments Payment[]

  @@unique([companyId, number])
  @@index([companyId, date])
}

model InvoiceItem {
  id         String  @id @default(cuid())
  itemId     String?
  itemName   String
  hsn        String?
  quantity   Float
  unit       String  @default("NOS")
  rate       Float
  discount   Float   @default(0)
  taxableAmount Float @default(0)
  gstRate    Float   @default(0)
  cgst       Float   @default(0)
  sgst       Float   @default(0)
  igst       Float   @default(0)
  total      Float   @default(0)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item      Item?   @relation(fields: [itemId], references: [id])
}

model Purchase {
  id            String   @id @default(cuid())
  number        String
  vendorBillNo  String?
  date          DateTime @default(now())
  dueDate       DateTime?
  notes         String?
  status        String   @default("UNPAID")
  subTotal      Float    @default(0)
  cgstTotal     Float    @default(0)
  sgstTotal     Float    @default(0)
  igstTotal     Float    @default(0)
  taxTotal      Float    @default(0)
  discount      Float    @default(0)
  roundOff      Float    @default(0)
  grandTotal    Float    @default(0)
  amountPaid    Float    @default(0)
  isInterState  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id])

  items    PurchaseItem[]
  payments Payment[]

  @@unique([companyId, number])
  @@index([companyId, date])
}

model PurchaseItem {
  id         String  @id @default(cuid())
  itemId     String?
  itemName   String
  hsn        String?
  quantity   Float
  unit       String  @default("NOS")
  rate       Float
  discount   Float   @default(0)
  taxableAmount Float @default(0)
  gstRate    Float   @default(0)
  cgst       Float   @default(0)
  sgst       Float   @default(0)
  igst       Float   @default(0)
  total      Float   @default(0)

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item       Item?    @relation(fields: [itemId], references: [id])
}

model Payment {
  id         String   @id @default(cuid())
  number     String
  date       DateTime @default(now())
  type       String   // RECEIVED | PAID
  mode       String   @default("CASH") // CASH | BANK | UPI | CHEQUE | CARD
  reference  String?
  amount     Float
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partyId    String
  party      Party    @relation(fields: [partyId], references: [id])

  invoiceId  String?
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  @@unique([companyId, number])
  @@index([companyId, date])
}

model StockMovement {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  type      String   // IN | OUT
  quantity  Float
  reference String?  // invoice/purchase number
  notes     String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([companyId, itemId])
}


model Quotation {
  id           String   @id @default(cuid())
  number       String
  date         DateTime @default(now())
  validUntil   DateTime?
  notes        String?
  status       String   @default("OPEN") // OPEN | ACCEPTED | CONVERTED | EXPIRED | REJECTED
  subTotal     Float    @default(0)
  cgstTotal    Float    @default(0)
  sgstTotal    Float    @default(0)
  igstTotal    Float    @default(0)
  taxTotal     Float    @default(0)
  discount     Float    @default(0)
  roundOff     Float    @default(0)
  grandTotal   Float    @default(0)
  isInterState Boolean  @default(false)
  convertedInvoiceId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id])

  items QuotationItem[]

  @@unique([companyId, number])
  @@index([companyId, date])
}

model QuotationItem {
  id            String  @id @default(cuid())
  itemId        String?
  itemName      String
  hsn           String?
  quantity      Float
  unit          String  @default("NOS")
  rate          Float
  discount      Float   @default(0)
  taxableAmount Float   @default(0)
  gstRate       Float   @default(0)
  cgst          Float   @default(0)
  sgst          Float   @default(0)
  igst          Float   @default(0)
  total         Float   @default(0)

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  item        Item?     @relation(fields: [itemId], references: [id])
}

model CreditNote {
  id           String   @id @default(cuid())
  number       String
  kind         String   @default("CREDIT") // CREDIT (sales return) | DEBIT (purchase return)
  date         DateTime @default(now())
  reason       String?
  notes        String?
  originalRef  String?  // original invoice/purchase number
  subTotal     Float    @default(0)
  cgstTotal    Float    @default(0)
  sgstTotal    Float    @default(0)
  igstTotal    Float    @default(0)
  taxTotal     Float    @default(0)
  discount     Float    @default(0)
  roundOff     Float    @default(0)
  grandTotal   Float    @default(0)
  isInterState Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id])

  items CreditNoteItem[]

  @@unique([companyId, number])
  @@index([companyId, date])
}

model CreditNoteItem {
  id            String  @id @default(cuid())
  itemId        String?
  itemName      String
  hsn           String?
  quantity      Float
  unit          String  @default("NOS")
  rate          Float
  discount      Float   @default(0)
  taxableAmount Float   @default(0)
  gstRate       Float   @default(0)
  cgst          Float   @default(0)
  sgst          Float   @default(0)
  igst          Float   @default(0)
  total         Float   @default(0)

  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  item         Item?      @relation(fields: [itemId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  number      String
  date        DateTime @default(now())
  category    String   @default("General")
  paymentMode String   @default("CASH")
  amount      Float    @default(0)
  gstRate     Float    @default(0)
  taxAmount   Float    @default(0)
  total       Float    @default(0)
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partyId   String?
  party     Party?  @relation(fields: [partyId], references: [id])

  @@unique([companyId, number])
  @@index([companyId, date])
}


// ======================== GODOWNS / WAREHOUSES ========================
model Godown {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items          Item[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")

  @@index([companyId])
}

model StockTransfer {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  itemId    String
  quantity  Float
  notes     String?
  createdAt DateTime @default(now())

  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromGodownId String
  fromGodown   Godown  @relation("TransferFrom", fields: [fromGodownId], references: [id])
  toGodownId   String
  toGodown     Godown  @relation("TransferTo", fields: [toGodownId], references: [id])

  @@index([companyId])
}

// ======================== RECURRING INVOICES ========================
model RecurringInvoice {
  id           String   @id @default(cuid())
  name         String
  partyId      String
  frequency    String   @default("MONTHLY") // WEEKLY | MONTHLY | QUARTERLY | YEARLY
  dayOfMonth   Int      @default(1)
  nextRunDate  DateTime
  lastRunDate  DateTime?
  isActive     Boolean  @default(true)
  template     String   // JSON string of items + meta for auto-generation
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
}

// ======================== BANK RECONCILIATION ========================
model BankTransaction {
  id           String   @id @default(cuid())
  date         DateTime
  description  String
  reference    String?
  debit        Float    @default(0)
  credit       Float    @default(0)
  balance      Float    @default(0)
  isMatched    Boolean  @default(false)
  matchedPaymentId String?
  createdAt    DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isMatched])
}

// ======================== BUDGETS ========================
model Budget {
  id        String   @id @default(cuid())
  name      String
  category  String   // Sales | Purchases | Expenses | Rent | Salaries etc.
  period    String   // "2025-04" for monthly or "2025-Q1" etc.
  amount    Float    @default(0)
  createdAt DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, category, period])
}

// ======================== AUDIT TRAIL ========================
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // CREATE | UPDATE | DELETE
  entity    String   // Invoice | Purchase | Party | Item | Payment etc.
  entityId  String
  changes   String?  // JSON diff of old vs new
  ipAddress String?
  createdAt DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  @@index([companyId, entity, createdAt])
}
